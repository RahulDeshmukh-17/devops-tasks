# Create the S3 bucket and DynamoDB table before terraform init.
terraform {
  backend "s3" {
    bucket = "REPLACE_WITH_UNIQUE_STATE_BUCKET"
    key = "devops-questionnaire/dev/terraform.tfstate"
    region = "ap-south-1"
    dynamodb_table = "REPLACE_WITH_STATE_LOCK_TABLE"
    encrypt = true
  }
}
